# Optional: enables Google Places Text Search + Place Details.
# Create a key with Places API enabled, then copy this file to .env.
GOOGLE_PLACES_API_KEY=

# Optional: enables official web-search source (no scraping).
# Use either Bing Search API or SerpAPI.
BING_SEARCH_API_KEY=
SERPAPI_API_KEY=

# Optional: override default output paths.
# OUTPUT_CSV=results/india_tech_companies.csv
# OUTPUT_JSON=results/india_tech_companies.json
